# ============ novel-agent-platform 环境变量示例 ============
# 复制为 .env 后填入实际值
# cp .env.example .env

# ===== PostgreSQL =====
PG_HOST=localhost
PG_PORT=5432
PG_DB=novel_agent
PG_USER=postgres
PG_PASSWORD=postgres

# ===== 默认 LLM (页面未配置时的 fallback) =====
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL_NAME=deepseek-chat

# ===== Grafana (可选, 取消 docker-compose.yml 注释启用) =====
GRAFANA_PASSWORD=admin123
